#!/usr/bin/env python3
# Run specloop from this checkout, without installing it. Symlinks to this
# file work too (install.sh makes one in ~/.local/bin).
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))

from specloop.cli import main_entry  # noqa: E402

main_entry()
