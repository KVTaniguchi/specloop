#!/bin/sh
#
# specloop trigger. When a commit changes the spec, start a background
# Claude Code session in its own worktree that runs /spec-sync and leaves
# the implementation on a <branchPrefix><sha> branch for review.
#
# Enable once per clone:   git config core.hooksPath tools/githooks
# Skip for one commit:     SPEC_SYNC=off git commit ...
# Test without launching:  SPEC_SYNC=dry-run git commit ...
# Watch / attach:          claude agents   |   claude attach "Spec sync <sha>"

[ "$SPEC_SYNC" = "off" ] && exit 0

root=$(git rev-parse --show-toplevel)
specloop="$root/tools/specloop"
[ -x "$specloop" ] || exit 0

spec=$("$specloop" config spec 2>/dev/null) || exit 0
prefix=$("$specloop" config sync.branchPrefix 2>/dev/null || echo "spec-sync/")
mode=$("$specloop" config sync.permissionMode 2>/dev/null || echo "auto")

git diff-tree --root --no-commit-id --name-only -r HEAD | grep -qxF "$spec" || exit 0

# Don't fire during rebases/cherry-picks or from inside a sync branch.
git_dir=$(git rev-parse --git-dir)
if [ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ] || [ -f "$git_dir/CHERRY_PICK_HEAD" ]; then
    exit 0
fi
case "$(git rev-parse --abbrev-ref HEAD)" in "$prefix"*) exit 0 ;; esac

short=$(git rev-parse --short HEAD)

if ! command -v claude >/dev/null 2>&1; then
    echo "specloop: claude CLI not found — run /spec-sync manually for $short"
    exit 0
fi

if [ "$SPEC_SYNC" = "dry-run" ]; then
    echo "specloop: would start background session 'Spec sync $short'"
    exit 0
fi

if claude --bg \
    --worktree "spec-sync-$short" \
    --name "Spec sync $short" \
    --permission-mode "$mode" \
    "/spec-sync" >/dev/null 2>&1; then
    echo "specloop: started background session 'Spec sync $short' (run 'claude agents' to watch)"
else
    echo "specloop: failed to start session — run /spec-sync manually for $short"
fi

exit 0
