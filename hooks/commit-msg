#!/bin/sh
#
# specloop: with "trailers": {"hook": true} in specloop.json, refuse a commit
# that changes code without a Spec-Rules trailer naming the rules it
# implements (or `Spec-Rules: none (reason)`). `tools/specloop trailers`
# prints the block. Skip once with git commit --no-verify.

root=$(git rev-parse --show-toplevel)
specloop="$root/tools/specloop"
[ -x "$specloop" ] || exit 0
exec "$specloop" trailers --verify "$1"
