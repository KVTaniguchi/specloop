#!/bin/sh
#
# specloop trigger, shared by the post-commit, post-merge and post-rewrite
# hooks. When an update brings in a spec change the code doesn't match yet,
# start a background coding agent in its own worktree that runs /spec-sync
# and leaves the implementation on a <branchPrefix><sha> branch for review.
# The agent is Claude Code or Cursor (`tools/specloop harness`).
#
#   specloop-trigger commit           after a commit (compares with HEAD^1)
#   specloop-trigger merge|rebase     after a merge, pull or rebase (compares with ORIG_HEAD)
#
# Enable once per clone:   git config core.hooksPath tools/githooks
# Pick your agent:         git config specloop.harness cursor   (default: claude)
# Skip for one update:     SPEC_SYNC=off git commit ...   (or merge, pull)
# Test without launching:  SPEC_SYNC=dry-run git commit ...   (also dry-runs cleanup)
# Watch / attach:          tools/specloop status   |   claude agents

[ "$SPEC_SYNC" = "off" ] && exit 0

# Git runs hooks with variables about the commit in progress, some relative
# to this checkout (GIT_INDEX_FILE=.git/index in post-commit). Left in place
# they break git in the sync's worktree, and they'd stamp the sync's commit
# with this commit's date. Hooks run at the top of the work tree, so git
# finds the repository without them.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_REFLOG_ACTION \
    GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_AUTHOR_DATE \
    GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL GIT_COMMITTER_DATE

mode=${1:-commit}
root=$(git rev-parse --show-toplevel)
specloop="$root/tools/specloop"
[ -x "$specloop" ] || exit 0

prefix=$("$specloop" config sync.branchPrefix 2>/dev/null || echo "spec-sync/")
permission=$("$specloop" config sync.permissionMode 2>/dev/null || echo "auto")

# Don't fire mid-rebase or mid-cherry-pick, or from inside a sync branch.
git_dir=$(git rev-parse --git-dir)
if [ "$mode" = commit ] && { [ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ] || [ -f "$git_dir/CHERRY_PICK_HEAD" ]; }; then
    exit 0
fi
case "$(git rev-parse --abbrev-ref HEAD)" in "$prefix"*) exit 0 ;; esac

# Clear out worktrees of syncs that are merged or whose session died.
if [ "$SPEC_SYNC" = "dry-run" ]; then
    "$specloop" cleanup --dry-run
else
    "$specloop" cleanup --quiet
fi

if [ "$mode" = commit ]; then
    "$specloop" trigger || exit 0
else
    since=$(git rev-parse -q --verify ORIG_HEAD) || exit 0
    "$specloop" trigger --since "$since" || exit 0
fi

short=$(git rev-parse --short HEAD)
session="Spec sync $short"
harness=$("$specloop" harness) || exit 0

if [ "$harness" = cursor ]; then
    agent=$(command -v agent || command -v cursor-agent)
    if [ -z "$agent" ]; then
        echo "specloop: Cursor's agent CLI not found — run /spec-sync in Cursor for $short"
        exit 0
    fi
else
    if ! command -v claude >/dev/null 2>&1; then
        echo "specloop: claude CLI not found — run /spec-sync manually for $short"
        exit 0
    fi
fi

if [ "$SPEC_SYNC" = "dry-run" ]; then
    echo "specloop: would start background $harness session '$session'"
    exit 0
fi

# Absolute: the Cursor agent starts from inside its worktree.
common=$(cd "$(git rev-parse --git-common-dir)" && pwd)
logs="$common/specloop/logs"
mkdir -p "$logs"
log="$logs/$short.log"

if [ "$harness" = cursor ]; then
    # Cursor's agent has no background mode, so the hook makes the worktree,
    # starts the agent in it, and locks the worktree with the agent's pid the
    # way Claude Code does. Cleanup reads that lock.
    tree="$root/.specloop/worktrees/spec-sync-$short"
    branch="$prefix$short"
    if ! git check-ignore -q "$tree"; then
        mkdir -p "$common/info"
        printf '.specloop/worktrees/\n' >> "$common/info/exclude"
    fi
    "$specloop" sync starting --session "$session" --log "$log" --harness cursor >/dev/null
    if ! out=$(git worktree add -q -b "$branch" "$tree" HEAD 2>&1); then
        "$specloop" sync failed --rev HEAD --note "couldn't make the worktree: $out" >/dev/null
        echo "specloop: couldn't make the worktree ($out) — run /spec-sync manually for $short"
        exit 0
    fi
    prompt="Run a spec sync: follow .claude/skills/spec-sync/SKILL.md in this repository step by step. You were started by the specloop hook, in a worktree already on the branch $branch."
    (cd "$tree" && exec nohup "$agent" -p --force --trust --workspace "$tree" "$prompt" >"$log" 2>&1 </dev/null) &
    pid=$!
    git worktree lock --reason "cursor agent session spec-sync-$short (pid $pid)" "$tree"
    # A logged-out or misconfigured agent exits at once, before reporting in.
    sleep 1
    record="$common/specloop/syncs/$(git rev-parse HEAD).json"
    # The agent is this shell's child, so once it exits it's a zombie until
    # the hook ends, and kill -0 would still find it. Ask ps instead.
    case "$(ps -o stat= -p "$pid" 2>/dev/null)" in ""|Z*) alive=no ;; *) alive=yes ;; esac
    if [ "$alive" = no ] && grep -q '"status": "starting"' "$record" 2>/dev/null; then
        reason=$(grep -v '^ *$' "$log" | head -n 1)
        "$specloop" sync failed --rev HEAD --note "agent exited at once: ${reason:-no output}" >/dev/null
        echo "specloop: Cursor's agent exited at once: ${reason:-see $log} — run /spec-sync manually for $short"
        exit 0
    fi
    echo "specloop: started background Cursor agent '$session' (tools/specloop status to follow it, output in $log)"
    exit 0
fi

# Claude Code doesn't hide its worktrees from git, so a `git add -A` here
# would stage one as an embedded repository. Exclude them in this clone.
if ! git check-ignore -q ".claude/worktrees/spec-sync-$short"; then
    mkdir -p "$common/info"
    printf '.claude/worktrees/\n' >> "$common/info/exclude"
fi

# A logged-out CLI still launches, then dies inside the session. Say so now.
if claude auth status 2>/dev/null | grep -q '"loggedIn": *false'; then
    "$specloop" sync failed --rev HEAD --note "the claude CLI isn't logged in; run claude auth login, then /spec-sync" >/dev/null
    echo "specloop: the claude CLI isn't logged in (claude auth login) — run /spec-sync manually for $short"
    exit 0
fi

"$specloop" sync starting --session "$session" --log "$log" >/dev/null
if claude --bg \
    --worktree "spec-sync-$short" \
    --name "$session" \
    --permission-mode "$permission" \
    "/spec-sync" >"$log" 2>&1; then
    # --bg picks the session ID and prints it ("backgrounded · 9c694670 · …").
    # Record it without touching the status, which the session may have set by now.
    id=$(grep -o 'backgrounded[^0-9a-f]*[0-9a-f]\{8\}' "$log" | grep -o '[0-9a-f]\{8\}$' | head -n 1)
    [ -n "$id" ] && "$specloop" sync --session-id "$id" >/dev/null
    echo "specloop: started background session '$session' (tools/specloop status to follow it${id:+, claude attach $id to watch})"
else
    reason=$(grep -v '^ *$' "$log" | head -n 1)
    "$specloop" sync failed --rev HEAD --note "claude --bg failed: ${reason:-no output}" >/dev/null
    echo "specloop: failed to start session: ${reason:-see $log} — run /spec-sync manually for $short"
fi

exit 0
